{
  "metadata": {
    "version": "1.0.0",
    "author": "Hog Bay Software",
    "appearance": "light"
  },
  "colors": {
    "bg": "#fcfcfc",
    "fg": "#5c6166",
    "ui": "#8a9199",
    "ayuAccent": "#ffaa33",
    "tag": "#55b4d4",
    "func": "#f2ae49",
    "entity": "#399ee6",
    "string": "#86b300",
    "regexp": "#4cbf99",
    "markup": "#f07171",
    "keyword": "#fa8d3e",
    "special": "#e6ba7e",
    "comment": "#abadb1",
    "constant": "#a37acc",
    "operator": "#ed9366",
    "error": "#e65050",
    "vcsAdded": "#6cbf43",
    "vcsModified": "#478acc",
    "vcsRemoved": "#ff7383",

    "text": "$fg",
    "secondaryText": "$ui",
    "accent": "$ayuAccent",
    "background": "$bg",
    "caret": "$accent",
    "caretLine": "rgb(from $ui r g b / 10%)",
    "caretMessage": "$secondaryText",
    "textBackgroundSelected": "rgb(from $entity r g b / 15%)",
    "blockBackgroundSelected": "rgb(from $entity r g b / 15%)",
    "findMatch": "color-mix(in oklch, $func 40%, $background)",
    "findMatchCurrent": "oklch(from $func calc(l - 0.1) c h)",
    "handle": "$text",
    "handleUnloaded": "color-mix(in oklch, $handle 30%, $background)",
    "guideLine": "color-mix(in oklch, $handleUnloaded 65%, $background)",
    "focusArrow": "$handleUnloaded",
    "spelling": "$error",
    "grammar": "$string",
    "replacement": "$constant",

    "themePanel": "color-mix(in oklch, $bg 96%, $fg)",
    "themeInactivePanel": "color-mix(in oklch, $themePanel 90%, $text)",
    "themeDivider": "rgb(from $ui r g b / 25%)",
    "themeSecondaryDivider": "rgb(from $themeDivider r g b / calc(alpha * 0.5))",
    "themeContentDivider": "$themeDivider"
  },
  "materials": {
    "window": {
      "fill": {
        "type": "active",
        "active": "$themePanel",
        "inactive": "$themeInactivePanel"
      }
    },
    "titlebar": {},
    "sidebar": {},
    "editorPane": {
      "fill": "$background",
      "cornerRadius": {
        "topLeading": 8
      },
      "borders": {
        "leading": "$themeContentDivider",
        "top": "$themeContentDivider",
        "trailing": "$themeDivider"
      }
    },
    "editor": {},
    "editorToolbar": {
      "fill": "$background",
      "borders": {
        "bottom": "$themeSecondaryDivider"
      }
    },
    "editorPanel": {
      "fill": "$background",
      "borders": {
        "top": "$themeSecondaryDivider"
      }
    },
    "editorStatusBar": {
      "fill": "$background",
      "borders": {
        "top": "$themeSecondaryDivider"
      }
    },
    "inspector": {
      "fill": "$background",
      "borders": {
        "top": "$themeContentDivider"
      }
    }
  },
  "rows": {
    "body": {
      "color": "$text"
    },
    "heading": {
      "color": "$keyword",
      "fontWeight": "semibold"
    },
    "note": {
      "color": "$secondaryText"
    },
    "blockquote": {
      "color": "$tag",
      "fontTraits": ["italic"]
    },
    "codeblock": {
      "color": "$string",
      "fontTraits": ["monospace"]
    },
    "task": {
      "color": "$text"
    },
    "orderedList": {
      "color": "$text"
    },
    "unorderedList": {
      "color": "$text"
    },
    "horizontalRule": {
      "color": "$themeDivider"
    }
  },
  "runs": {
    "strong": {
      "fontWeight": "semibold"
    },
    "emphasis": {
      "fontTraits": ["italic"]
    },
    "strikethrough": {
      "color": "$secondaryText",
      "strikethrough": {
        "single": true
      }
    },
    "code": {
      "color": "$constant",
      "fontTraits": ["monospace"]
    },
    "mark": {
      "backgroundColor": "rgb(from $func r g b / 30%)"
    },
    "link": {
      "color": "$accent",
      "underline": {
        "single": true
      }
    }
  }
}
