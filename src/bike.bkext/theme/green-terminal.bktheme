{
  "metadata": {
    "version": "1.0.0",
    "author": "Hog Bay Software",
    "appearance": "dark"
  },
  "colors": {
    "bg": "#001500",
    "fg": "#33ff33",

    "text": "$fg",
    "secondaryText": "color-mix(in oklch, $fg 50%, $bg)",
    "accent": "$fg",
    "background": "$bg",
    "caret": "$accent",
    "caretLine": "rgb(from $fg r g b / 6%)",
    "caretMessage": "$secondaryText",
    "textBackgroundSelected": "color-mix(in oklch, $bg 80%, $fg)",
    "blockBackgroundSelected": "color-mix(in oklch, $bg 80%, $fg)",
    "findMatch": "color-mix(in oklch, $bg 60%, $fg)",
    "findMatchCurrent": "$fg",
    "handle": "$text",
    "handleUnloaded": "color-mix(in oklch, $fg 15%, $bg)",
    "guideLine": "color-mix(in oklch, $handleUnloaded 5%, $bg)",
    "focusArrow": "$handleUnloaded",
    "spelling": "$fg",
    "grammar": "color-mix(in oklch, $fg 70%, $bg)",
    "replacement": "$secondaryText",

    "themePanel": "color-mix(in oklch, $bg 95%, $fg)",
    "themeInactivePanel": "color-mix(in oklch, $themePanel 90%, $text)",
    "themeDivider": "rgb(from $fg r g b / 25%)",
    "themeSecondaryDivider": "rgb(from $themeDivider r g b / calc(alpha * 0.5))",
    "themeContentDivider": "$themeDivider"
  },
  "materials": {
    "window": {
      "fill": {
        "type": "active",
        "active": "$themePanel",
        "inactive": "$themeInactivePanel"
      }
    },
    "titlebar": {},
    "sidebar": {},
    "editorPane": {
      "fill": "$background",
      "cornerRadius": {
        "topLeading": 8
      },
      "borders": {
        "leading": "$themeContentDivider",
        "top": "$themeContentDivider",
        "trailing": "$themeDivider"
      }
    },
    "editor": {},
    "editorToolbar": {
      "fill": "$background",
      "borders": {
        "bottom": "$themeSecondaryDivider"
      }
    },
    "editorPanel": {
      "fill": "$background",
      "borders": {
        "top": "$themeSecondaryDivider"
      }
    },
    "editorStatusBar": {
      "fill": "$background",
      "borders": {
        "top": "$themeSecondaryDivider"
      }
    },
    "inspector": {
      "fill": "$background",
      "borders": {
        "top": "$themeContentDivider"
      }
    }
  },
  "rows": {
    "body": {
      "color": "$text"
    },
    "heading": {
      "color": "$text",
      "fontWeight": "semibold"
    },
    "note": {
      "color": "$secondaryText"
    },
    "blockquote": {
      "color": "$text",
      "fontTraits": ["italic"]
    },
    "codeblock": {
      "color": "$text",
      "fontTraits": ["monospace"]
    },
    "task": {
      "color": "$text"
    },
    "orderedList": {
      "color": "$text"
    },
    "unorderedList": {
      "color": "$text"
    },
    "horizontalRule": {
      "color": "$themeDivider"
    }
  },
  "runs": {
    "strong": {
      "color": "$text",
      "fontWeight": "semibold"
    },
    "emphasis": {
      "fontTraits": ["italic"]
    },
    "strikethrough": {
      "color": "$secondaryText",
      "strikethrough": {
        "single": true
      }
    },
    "code": {
      "color": "$text",
      "fontTraits": ["monospace"]
    },
    "mark": {
      "backgroundColor": "rgb(from $fg r g b / 25%)"
    },
    "link": {
      "color": "$accent",
      "underline": {
        "single": true
      }
    }
  }
}
