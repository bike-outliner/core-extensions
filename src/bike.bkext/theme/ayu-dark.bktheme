{
  "metadata": {
    "version": "1.0.0",
    "author": "Hog Bay Software",
    "appearance": "dark"
  },
  "colors": {
    "ayuBg": "#0b0e14",
    "ayuFg": "#bfbdb6",
    "ayuUi": "#565b66",
    "ayuAccent": "#e6b450",
    "ayuTag": "#39bae6",
    "ayuFunc": "#ffb454",
    "ayuEntity": "#59c2ff",
    "ayuString": "#aad94c",
    "ayuRegexp": "#95e6cb",
    "ayuMarkup": "#f07178",
    "ayuKeyword": "#ff8f40",
    "ayuSpecial": "#e6b673",
    "ayuComment": "#646b73",
    "ayuConstant": "#d2a6ff",
    "ayuOperator": "#f29668",
    "ayuError": "#d95757",
    "ayuVcsAdded": "#7fd962",
    "ayuVcsModified": "#73b8ff",
    "ayuVcsRemoved": "#f26d78",

    "themeText": "$ayuFg",
    "themeAccent": "$ayuAccent",
    "themeBackground": "$ayuBg",
    "themeHeading": "$ayuKeyword",
    "themeSelectionBackground": "rgb(from $ayuEntity r g b / 50%)",
    "themeLink": "$ayuAccent",
    "themeMark": "$ayuFunc",
    "themeError": "$ayuError",
    "themeGrammar": "$ayuString",
    "themeReplacement": "$ayuConstant",
    "themeMarkBackground": "rgb(from $themeMark r g b / 30%)",

    "text": "$themeText",
    "accent": "$themeAccent",
    "background": "$themeBackground",
    "caret": "$themeAccent",
    "caretLine": "rgb(from $themeAccent r g b / 15%)",
    "caretMessage": "color-mix(in oklch, $text 50%, $themeBackground)",
    "textBackgroundSelected": "$themeSelectionBackground",
    "blockBackgroundSelected": "$themeSelectionBackground",
    "contentBackgroundSelectedUnemphasized": "rgb(from $themeSelectionBackground r g b / calc(alpha * 0.5))",
    "findMatch": "oklch(from $themeAccent calc(l - 0.2) c h / calc(alpha * 0.4))",
    "findMatchCurrent": "oklch(from $themeAccent calc(l + 0.1) c h)",
    "handle": "$text",
    "handleUnloaded": "rgb(from $handle r g b / calc(alpha * 0.4))",
    "guideLine": "rgb(from $handleUnloaded r g b / calc(alpha * 0.5))",
    "focusArrow": "$handleUnloaded",
    "grammar": "$themeGrammar",
    "spelling": "$themeError",
    "replacement": "$themeReplacement",

    "themePanel": "color-mix(in oklch, $themeBackground 80%, $themeText)",
    "themeInactivePanel": "color-mix(in oklch, $themePanel 60%, $themeBackground)",
    "themeDivider": "$themePanel",
    "themeSecondaryDivider": "rgb(from $themeDivider r g b / calc(alpha * 0.5))",
    "themeContentDivider": "black"
  },
  "materials": {
    "window": {
      "fill": {
        "type": "active",
        "active": "$themePanel",
        "inactive": "$themeInactivePanel"
      }
    },
    "titlebar": {},
    "sidebar": {},
    "editorPane": {
      "fill": "$background",
      "cornerRadius": {
        "topLeading": 8
      },
      "borders": {
        "leading": "$themeContentDivider",
        "top": "$themeContentDivider",
        "trailing": "$themeDivider"
      }
    },
    "editor": {},
    "editorToolbar": {
      "fill": "$background",
      "borders": {
        "bottom": "$themeSecondaryDivider"
      }
    },
    "editorPanel": {
      "fill": "$background",
      "borders": {
        "top": "$themeSecondaryDivider"
      }
    },
    "editorStatusBar": {
      "fill": "$background",
      "borders": {
        "top": "$themeSecondaryDivider"
      }
    },
    "inspector": {
      "fill": "$background",
      "borders": {
        "top": "$themeContentDivider"
      }
    }
  },
  "rows": {
    "body": {
      "color": "$text"
    },
    "heading": {
      "color": "$themeHeading",
      "fontWeight": "semibold"
    },
    "note": {
      "fontTraits": ["italic"]
    },
    "blockquote": {
      "fontTraits": ["italic"]
    },
    "codeblock": {
      "fontTraits": ["monospace"]
    },
    "task": {
      "color": "$text"
    },
    "orderedList": {
      "color": "$text"
    },
    "unorderedList": {
      "color": "$text"
    },
    "horizontalRule": {
      "color": "$themeDivider"
    }
  },
  "runs": {
    "strong": {
      "fontWeight": "semibold"
    },
    "emphasis": {
      "fontTraits": ["italic"]
    },
    "strikethrough": {
      "strikethrough": {
        "single": true
      }
    },
    "code": {
      "fontTraits": ["monospace"]
    },
    "mark": {
      "backgroundColor": "$themeMarkBackground"
    },
    "link": {
      "color": "$themeLink",
      "underline": {
        "single": true
      }
    }
  }
}
